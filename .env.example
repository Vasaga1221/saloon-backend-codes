# ---- app
APP_ENV=local                      # local | test | production
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]     # JSON list; the two Vite frontends run on :3000
PUBLIC_BASE_URL=http://localhost:8000

# ---- database (PostgreSQL 14+; psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://aura:aura@localhost:5432/aura

# ---- secrets: generate each with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-in-production-change-me-in-production
OTP_PEPPER=change-me-otp-pepper
PASS_SIGNING_SECRET=change-me-pass-secret

# ---- auth / OTP
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER=console               # console (logs the code) | none. Wire a real SMS/email provider for production
OTP_DEV_ECHO=true                  # returns the OTP in the API response: LOCAL ONLY
REQUIRE_VERIFIED_FOR_BOOKING=true

# ---- booking policy
DEFAULT_TIMEZONE=Asia/Kolkata
MIN_BOOKING_LEAD_MINUTES=30
CANCELLATION_CUTOFF_HOURS=2
MAX_BOOKING_HORIZON_DAYS=60
TAX_AFTER_DISCOUNT=false           # false = GST on the pre-discount subtotal, exactly like the frontend

# ---- payments
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=false          # must be true to run APP_ENV=production with the mock gateway

# ---- rate limiting (per-process)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
